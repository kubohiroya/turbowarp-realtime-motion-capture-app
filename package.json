{
  "name": "multiview-pose",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check:apps": "pnpm --recursive --if-present run check",
    "check:extensions": "node scripts/check-extension-readiness.mjs",
    "format": "node scripts/check-format.mjs",
    "lint": "node scripts/check-repository.mjs",
    "test": "pnpm --filter @multiview-pose/protocol test && node scripts/check-deterministic-builds.mjs",
    "typecheck": "node scripts/check-script-syntax.mjs && pnpm --filter @multiview-pose/protocol typecheck",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run check:extensions && pnpm run check:apps && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "0.12.0",
    "typescript": "5.9.3"
  }
}

{
  "name": "multiview-pose",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check:apps": "pnpm --recursive --if-present run check",
    "check:extensions": "node --experimental-strip-types scripts/check-extension-readiness.ts",
    "format": "node --experimental-strip-types scripts/check-format.ts",
    "lint": "node --experimental-strip-types scripts/check-repository.ts",
    "test": "node --experimental-strip-types scripts/check-deterministic-builds.ts",
    "typecheck": "tsc --project tsconfig.json && node --experimental-strip-types scripts/check-script-syntax.ts",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run check:extensions && pnpm run check:apps && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "0.12.0",
    "@types/node": "22.13.0",
    "typescript": "5.9.3"
  }
}

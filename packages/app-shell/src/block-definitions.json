{
  "blocks": [
    {
      "opcode": "showAppLoading",
      "blockType": "COMMAND",
      "text": "show loading [LABEL]",
      "description": "Shows the loading overlay with an indeterminate progress indicator.",
      "arguments": {
        "LABEL": {
          "type": "STRING",
          "defaultValue": "Starting"
        }
      }
    },
    {
      "opcode": "showAppLoadingProgress",
      "blockType": "COMMAND",
      "text": "show loading [LABEL] at [PERCENT] %",
      "description": "Shows the loading overlay with a determinate progress indicator.",
      "arguments": {
        "LABEL": {
          "type": "STRING",
          "defaultValue": "Calibrating"
        },
        "PERCENT": {
          "type": "NUMBER",
          "defaultValue": 0
        }
      }
    },
    {
      "opcode": "hideAppLoading",
      "blockType": "COMMAND",
      "text": "hide loading",
      "description": "Hides the loading overlay.",
      "arguments": {}
    },
    {
      "opcode": "showAppNotice",
      "blockType": "COMMAND",
      "text": "show notice [MESSAGE]",
      "description": "Shows an ordinary notice. Use this for anything that is not a failure.",
      "arguments": {
        "MESSAGE": {
          "type": "STRING",
          "defaultValue": "2 cameras are connected"
        }
      }
    },
    {
      "opcode": "showAppError",
      "blockType": "COMMAND",
      "text": "show error [MESSAGE] with details [DETAILS]",
      "description": "Shows a failure that stopped the application, and renders a JSON object as diagnostic details.",
      "arguments": {
        "MESSAGE": {
          "type": "STRING",
          "defaultValue": "The camera is not connected"
        },
        "DETAILS": {
          "type": "STRING",
          "defaultValue": "{}"
        }
      }
    },
    {
      "opcode": "hideAppMessage",
      "blockType": "COMMAND",
      "text": "hide message",
      "description": "Hides the runtime message overlay.",
      "arguments": {}
    },
    {
      "opcode": "appLocale",
      "blockType": "REPORTER",
      "text": "app locale",
      "description": "Reports the resolved shell locale, either en or ja.",
      "arguments": {}
    },
    {
      "opcode": "appShellState",
      "blockType": "REPORTER",
      "text": "app shell state",
      "description": "Reports unmounted, ready, or unavailable.",
      "arguments": {}
    },
    {
      "opcode": "webGpuAvailable",
      "blockType": "BOOLEAN",
      "text": "WebGPU available?",
      "description": "Reports whether this browser exposes the WebGPU navigator API.",
      "arguments": {}
    },
    {
      "opcode": "appFeatureFlagState",
      "blockType": "REPORTER",
      "text": "feature flag state",
      "description": "Reports applied, replaced, or too-late. Only applied means the contract extension observed this app's flags.",
      "arguments": {}
    },
    {
      "opcode": "appFeatureEnabled",
      "blockType": "BOOLEAN",
      "text": "feature [FEATURE] requested",
      "description": "Reports whether this application requested the named contract feature flag.",
      "arguments": {
        "FEATURE": {
          "type": "STRING",
          "menu": "featureFlags"
        }
      }
    },
    {
      "opcode": "openLensCalibrationApp",
      "blockType": "COMMAND",
      "text": "open lens calibration app",
      "description": "Opens the lens calibration app served beside this one on the same origin, in its own window. Waits only for the window to open, not for a calibration.",
      "arguments": {},
      "requires": "lensCalibration"
    },
    {
      "opcode": "lensCalibrationAppState",
      "blockType": "REPORTER",
      "text": "lens calibration app state",
      "description": "Reports open, closed, unavailable (no calibration app on this origin), or blocked (the browser refused the window).",
      "arguments": {},
      "requires": "lensCalibration"
    },
    {
      "opcode": "lensCalibrationAppOpen",
      "blockType": "BOOLEAN",
      "text": "lens calibration app is open?",
      "description": "Reports whether the calibration window opened by this app is still open.",
      "arguments": {},
      "requires": "lensCalibration"
    },
    {
      "opcode": "chooseLensCalibrationFile",
      "blockType": "COMMAND",
      "text": "choose lens calibration file",
      "description": "Asks the operator for a profile JSON file through a dialog, and waits until a file is read or the dialog is cancelled.",
      "arguments": {},
      "requires": "lensCalibration"
    },
    {
      "opcode": "chosenLensCalibrationFile",
      "blockType": "REPORTER",
      "text": "chosen lens calibration file",
      "description": "Reports the text of the file chosen last, or an empty string when the choice was cancelled.",
      "arguments": {},
      "requires": "lensCalibration"
    },
    {
      "opcode": "showQrImage",
      "blockType": "COMMAND",
      "text": "show QR image [IMAGE] caption [CAPTION] buttons [BUTTONS]",
      "description": "Shows an image data URI full screen on white with a caption and buttons separated by |. Replaces the image in place when already shown. Anything but an image data URI is ignored.",
      "arguments": {
        "IMAGE": {
          "type": "STRING",
          "defaultValue": ""
        },
        "CAPTION": {
          "type": "STRING",
          "defaultValue": "1 / 1"
        },
        "BUTTONS": {
          "type": "STRING",
          "defaultValue": "Next|Cancel"
        }
      }
    },
    {
      "opcode": "hideQrImage",
      "blockType": "COMMAND",
      "text": "hide QR image",
      "description": "Removes the QR image panel.",
      "arguments": {}
    },
    {
      "opcode": "qrImageButtonPresses",
      "blockType": "REPORTER",
      "text": "QR image button presses",
      "description": "Reports how many times any panel button has been pressed. Compare with a saved value to notice a new press.",
      "arguments": {}
    },
    {
      "opcode": "lastQrImageButton",
      "blockType": "REPORTER",
      "text": "last QR image button",
      "description": "Reports the label of the button pressed last.",
      "arguments": {}
    }
  ]
}
